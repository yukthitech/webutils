<testData 
	xmlns:s="http://autox.yukthitech.com/steps" 
	xmlns:wrap="http://xmlbeanparser.yukthitech.com/wrap" 
	xmlns:f="http://autox.yukthitech.com/functions">

	<testSuite name="webutils-ui-editable-lov-field" author="webutils"
		description="CATEGORY editable LOV (vue-multiselect) — persist true/false and TEMP_TABLE">

		<setup>
			<s:log level="INFO" message="Suite setup: clear TEMP_TABLE and Autox LOV option rows"/>
			<s:sql-multi-dml-query>
				<query>DELETE FROM TEMP_TABLE</query>
				<query>
					DELETE FROM STORED_LOV_OPTION
					WHERE LABEL = 'AutoxLovGadgets'
						AND LOV_ID = (SELECT ID FROM STORED_LOV WHERE NAME = 'CATEGORY')
				</query>
				<query>
					DELETE FROM STORED_LOV_OPTION
					WHERE LABEL = 'ELECTRONICS' COLLATE utf8mb4_bin
						AND LOV_ID = (SELECT ID FROM STORED_LOV WHERE NAME = 'CATEGORY')
				</query>
			</s:sql-multi-dml-query>
		</setup>

		<testCase name="lovCategorySelectClickPersist">
			<description>
				Selecting Electronics by locator and submitting persists CATEGORY=Electronics into TEMP_TABLE.
			</description>

			<s:ui-goto-page uri="/widgets/editable-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #category .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-fill-form>
				<data>json: {
					"c:ykEditableLov:category": "Electronics"
				}</data>
			</s:ui-fill-form>
			<s:ui-log-screen-shot name="editable-lov-click-electronics-filled"/>

			<s:ui-click locator="id: editable-lov-demo-submit-btn"
				post-visibility-locator="id: webutils-alert-ok-btn"
				retry-count="20" retry-time-gap-millis="500"/>
			<s:ui-click locator="id: webutils-alert-ok-btn"
				post-visibility-locator="id: editable-lov-demo-response"
				retry-count="15" retry-time-gap-millis="500"/>

			<s:sql-load-query-row-map contextAttribute="tempRow" processAllRows="false">
				<query><![CDATA[
					SELECT CATEGORY FROM TEMP_TABLE ORDER BY ID DESC LIMIT 1
				]]></query>
			</s:sql-load-query-row-map>
			<s:assert-equals actual="prop: attr.tempRow.CATEGORY" expected="string: Electronics"/>
		</testCase>

		<testCase name="lovCategoryCaseInsensitivePersist">
			<description>
				Typing ELECTRONICS maps to Electronics; no ELECTRONICS option row created.
			</description>

			<s:ui-goto-page uri="/widgets/editable-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #category .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-click locator="css: #category .multiselect__tags" retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-wait-for retry-count="15" retry-time-gap-millis="300">
				<locator>css: #category .multiselect--active .multiselect__input</locator>
			</s:ui-wait-for>
			<s:ui-set-value locator="css: #category .multiselect--active .multiselect__input" value="string: ELECTRONICS" press-enter-at-end="true"/>
			<s:ui-log-screen-shot name="editable-lov-case-electronics-typed"/>

			<s:ui-click locator="id: editable-lov-demo-submit-btn"
				post-visibility-locator="id: webutils-alert-ok-btn"
				retry-count="20" retry-time-gap-millis="500"/>
			<s:ui-click locator="id: webutils-alert-ok-btn"
				post-visibility-locator="id: editable-lov-demo-response"
				retry-count="15" retry-time-gap-millis="500"/>

			<s:sql-load-query-row-map contextAttribute="tempRow" processAllRows="false">
				<query><![CDATA[
					SELECT CATEGORY FROM TEMP_TABLE ORDER BY ID DESC LIMIT 1
				]]></query>
			</s:sql-load-query-row-map>
			<s:assert-equals actual="prop: attr.tempRow.CATEGORY" expected="string: Electronics"/>

			<s:sql-fetch-value-query context-attribute="electronicsExactCount">
				<query><![CDATA[
					SELECT COUNT(*)
					FROM STORED_LOV_OPTION
					WHERE LABEL = 'ELECTRONICS' COLLATE utf8mb4_bin
						AND LOV_ID = (SELECT ID FROM STORED_LOV WHERE NAME = 'CATEGORY')
				]]></query>
			</s:sql-fetch-value-query>
			<s:assert-equals actual="attr: electronicsExactCount" expected="int: 0"/>
		</testCase>

		<testCase name="lovCategoryNewOptionPersist">
			<description>
				Typing AutoxLovGadgets creates STORED_LOV_OPTION and TEMP_TABLE row.
			</description>

			<s:ui-goto-page uri="/widgets/editable-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #category .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-click locator="css: #category .multiselect__tags" retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-wait-for retry-count="15" retry-time-gap-millis="300">
				<locator>css: #category .multiselect--active .multiselect__input</locator>
			</s:ui-wait-for>
			<s:ui-set-value locator="css: #category .multiselect--active .multiselect__input" value="string: AutoxLovGadgets" press-enter-at-end="true"/>
			<s:ui-log-screen-shot name="editable-lov-new-option-typed"/>

			<s:ui-click locator="id: editable-lov-demo-submit-btn"
				post-visibility-locator="id: webutils-alert-ok-btn"
				retry-count="20" retry-time-gap-millis="500"/>
			<s:ui-click locator="id: webutils-alert-ok-btn"
				post-visibility-locator="id: editable-lov-demo-response"
				retry-count="15" retry-time-gap-millis="500"/>

			<s:sql-load-query-row-map contextAttribute="tempRow" processAllRows="false">
				<query><![CDATA[
					SELECT CATEGORY FROM TEMP_TABLE ORDER BY ID DESC LIMIT 1
				]]></query>
			</s:sql-load-query-row-map>
			<s:assert-equals actual="prop: attr.tempRow.CATEGORY" expected="string: AutoxLovGadgets"/>

			<s:sql-fetch-value-query context-attribute="newOptionCount">
				<query><![CDATA[
					SELECT COUNT(*)
					FROM STORED_LOV_OPTION
					WHERE LABEL = 'AutoxLovGadgets'
						AND LOV_ID = (SELECT ID FROM STORED_LOV WHERE NAME = 'CATEGORY')
				]]></query>
			</s:sql-fetch-value-query>
			<s:assert-equals actual="attr: newOptionCount" expected="int: 1"/>
		</testCase>

		<testCase name="lovCategoryPersistFalseNoCreate">
			<description>
				categoryFilter has persist=false — typing a brand-new value must not offer create/tag.
			</description>

			<s:ui-goto-page uri="/widgets/editable-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #categoryFilter .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-click locator="css: #categoryFilter .multiselect__tags" retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-wait-for retry-count="15" retry-time-gap-millis="300">
				<locator>css: #categoryFilter .multiselect--active .multiselect__input</locator>
			</s:ui-wait-for>
			<s:ui-set-value locator="css: #categoryFilter .multiselect--active .multiselect__input" value="string: AutoxNoPersistFilter" press-enter-at-end="false"/>
			<s:sleep time="800"/>
			<s:ui-assert-visibility
				locator="xpath: //div[@id='categoryFilter']//span[contains(@class,'multiselect__option') and contains(.,'No elements found')]"
				retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-log-screen-shot name="editable-lov-persist-false-no-create"/>

			<s:sql-fetch-value-query context-attribute="noPersistCount">
				<query><![CDATA[
					SELECT COUNT(*)
					FROM STORED_LOV_OPTION
					WHERE LABEL = 'AutoxNoPersistFilter'
						AND LOV_ID = (SELECT ID FROM STORED_LOV WHERE NAME = 'CATEGORY')
				]]></query>
			</s:sql-fetch-value-query>
			<s:assert-equals actual="attr: noPersistCount" expected="int: 0"/>
		</testCase>

	</testSuite>

</testData>
