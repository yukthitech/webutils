<testData 
	xmlns:s="http://autox.yukthitech.com/steps" 
	xmlns:wrap="http://xmlbeanparser.yukthitech.com/wrap" 
	xmlns:f="http://autox.yukthitech.com/functions">

	<testSuite name="webutils-ui-simple-lov-field" author="webutils"
		description="Simple Long CATEGORY LOV (vue-multiselect) — select and TEMP_TABLE persistence">

		<setup>
			<s:log level="INFO" message="Suite setup: clear TEMP_TABLE"/>
			<s:sql-multi-dml-query>
				<query>DELETE FROM TEMP_TABLE</query>
			</s:sql-multi-dml-query>
		</setup>

		<testCase name="simpleLovCategorySearchAndSelect">
			<description>
				Open dropdown, filter Ele, select Electronics, submit → TEMP_TABLE.CATEGORY = Electronics.
				CATEGORY has 4 options so search input is enabled.
			</description>

			<s:log level="INFO" message="Open simple LOV demo"/>
			<s:ui-goto-page uri="/widgets/simple-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #categoryId .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-click locator="css: #categoryId .multiselect__tags" retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-wait-for retry-count="15" retry-time-gap-millis="300">
				<locator>css: #categoryId .multiselect--active .multiselect__input</locator>
			</s:ui-wait-for>
			<s:ui-set-value locator="css: #categoryId .multiselect--active .multiselect__input" value="string: Ele" press-enter-at-end="false"/>
			<s:ui-wait-for retry-count="20" retry-time-gap-millis="300">
				<locator>xpath: //div[@id='categoryId']//span[contains(@class,'multiselect__option') and contains(normalize-space(.),'Electronics')]</locator>
			</s:ui-wait-for>
			<s:ui-click
				locator="xpath: //div[@id='categoryId']//span[contains(@class,'multiselect__option') and contains(normalize-space(.),'Electronics')]"
				retry-count="10" retry-time-gap-millis="300"/>
			<s:ui-log-screen-shot name="simple-lov-electronics-selected"/>

			<s:ui-click locator="id: simple-lov-demo-submit-btn"
				post-visibility-locator="id: webutils-alert-ok-btn"
				retry-count="20" retry-time-gap-millis="500"/>
			<s:ui-click locator="id: webutils-alert-ok-btn"
				post-visibility-locator="id: simple-lov-demo-response"
				retry-count="15" retry-time-gap-millis="500"/>

			<s:sql-load-query-row-map contextAttribute="tempRow" processAllRows="false">
				<query><![CDATA[
					SELECT CATEGORY FROM TEMP_TABLE ORDER BY ID DESC LIMIT 1
				]]></query>
			</s:sql-load-query-row-map>
			<s:assert-equals actual="prop: attr.tempRow.CATEGORY" expected="string: Electronics"/>
		</testCase>

		<testCase name="simpleLovCategorySelectViaLocator">
			<description>
				Select Books via c:ykLov custom locator and submit; persists CATEGORY=Books into TEMP_TABLE.
			</description>

			<s:ui-goto-page uri="/widgets/simple-lov-demo.html"/>
			<s:ui-wait-for retry-count="30" retry-time-gap-millis="500">
				<locator>css: #categoryId .multiselect</locator>
			</s:ui-wait-for>
			<s:sleep time="1500"/>

			<s:ui-fill-form>
				<data>json: {
					"c:ykLov:categoryId": "Books"
				}</data>
			</s:ui-fill-form>
			<s:ui-log-screen-shot name="simple-lov-books-filled"/>

			<s:ui-click locator="id: simple-lov-demo-submit-btn"
				post-visibility-locator="id: webutils-alert-ok-btn"
				retry-count="20" retry-time-gap-millis="500"/>
			<s:ui-click locator="id: webutils-alert-ok-btn"
				post-visibility-locator="id: simple-lov-demo-response"
				retry-count="15" retry-time-gap-millis="500"/>

			<s:sql-load-query-row-map contextAttribute="tempRow" processAllRows="false">
				<query><![CDATA[
					SELECT CATEGORY FROM TEMP_TABLE ORDER BY ID DESC LIMIT 1
				]]></query>
			</s:sql-load-query-row-map>
			<s:assert-equals actual="prop: attr.tempRow.CATEGORY" expected="string: Books"/>
		</testCase>

	</testSuite>

</testData>
